{
  "buildCommand": "npx expo export -p web && node scripts/prepare-vercel-web.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/record/:id",
      "destination": "/record/view"
    },
    {
      "source": "/customer/:id",
      "destination": "/customer/view"
    }
  ]
}
